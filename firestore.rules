rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Règle par défaut : Lecture publique pour tous les visiteurs du portfolio
    match /{document=**} {
      allow read: if true;
    }
    
    // 2. Collection Cinéma (Films & Séries) : Écriture réservée exclusivement à l'admin authentifié
    match /cinema/{filmId} {
      allow write: if request.auth != null;
    }
    
    // 3. Collection Projets & Documents pédagogiques : Écriture réservée à l'admin authentifié
    match /projects/{projectId} {
      allow write: if request.auth != null;
    }
    
    // 4. Collection Astuces & Conseils Informatiques : Écriture réservée à l'admin authentifié
    match /techTips/{tipId} {
      allow write: if request.auth != null;
    }
    
    // 5. Paramètres & Profil (settings/profile) : Écriture réservée à l'admin authentifié
    match /settings/{settingId} {
      allow write: if request.auth != null;
    }

    // 6. Collection Actualités : Écriture réservée à l'admin authentifié
    match /news/{newsId} {
      allow write: if request.auth != null;
    }

    // 7. Collection Catégories Personnalisées : Écriture réservée à l'admin authentifié
    match /customCategories/{catId} {
      allow write: if request.auth != null;
    }

    // 8. Collection Gaming & Moteurs 3D : Écriture réservée à l'admin authentifié
    match /gaming/{gameId} {
      allow write: if request.auth != null;
    }

    // 9. Collection Documents & Ressources : Écriture réservée à l'admin authentifié
    match /documents/{docId} {
      allow write: if request.auth != null;
    }

    // 10. Collection Snippets de Code & Scripts : Écriture réservée à l'admin authentifié
    match /codeSnippets/{snippetId} {
      allow write: if request.auth != null;
    }

    // 11. Collection Réalisations Portfolio : Écriture réservée à l'admin authentifié
    match /portfolioItems/{itemId} {
      allow write: if request.auth != null;
    }
  }
}
