rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Lecture publique de tous les documents téléchargeables (PDF, cours, etc.)
    match /{allPaths=**} {
      allow read: if true;
      // 2. Écriture réservée exclusivement à l'administrateur connecté
      allow write: if request.auth != null;
    }
  }
}
